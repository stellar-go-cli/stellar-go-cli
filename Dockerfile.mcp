# MCP Server Dockerfile — shared by the mcp (gatekeeper) and signer
# (custodian) compose services. Runs as a non-root user; the two services
# must share a UID because the custodian socket enforces peer-UID equality.
FROM golang:1.26-alpine AS builder

WORKDIR /app

# Install dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build MCP server CLI with memory optimizations
RUN CGO_ENABLED=0 GOOS=linux GOGC=off go build -p 1 -ldflags="-s -w" -o stellar-go-cli ./cmd/stellar-go-cli

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata \
  && addgroup -S stellar && adduser -S stellar -G stellar -h /home/stellar

WORKDIR /home/stellar

# Copy binary from builder
COPY --from=builder /app/stellar-go-cli /usr/local/bin/stellar-go-cli

# State dir (wallets, policy, enforcement log) — only mounted into the
# signer container; the gatekeeper container never sees key material.
RUN mkdir -p /home/stellar/.stellar-go-cli/state && chown -R stellar:stellar /home/stellar

USER stellar

# Expose port for SSE transport
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

# Default command for MCP server (the signer service overrides this)
CMD ["stellar-go-cli", "mcp", "--transport", "sse", "--port", "3000"]
